@model AddPack.Models.Series

@{
    ViewData["Title"] = "Usuń serię";
}

@section Styles {
    <link rel="stylesheet" href="~/css/series-index.css" asp-append-version="true" />
}

<div class="container mt-4 series-delete-page">
    <div class="series-toolbar d-flex justify-content-between align-items-center mb-4 pb-2">
        <h2 class="series-page-title mb-0 fw-bolder">Usuń serię</h2>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Wróć do listy
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="series-delete-card card border-0 shadow-sm">
                <div class="card-header text-white bg-danger">
                    <h5 class="mb-0"><i class="bi bi-trash me-2"></i>Dane serii do usunięcia</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" disabled class="form-control" placeholder="Wpisz nazwę serii" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Slug" class="form-label fw-bold"></label>
                            <input asp-for="Slug" disabled class="form-control" placeholder="np. moja-seria" />
                            <span asp-validation-for="Slug" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" disabled class="form-control" rows="4" placeholder="Opcjonalny opis serii"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ParentId" class="form-label fw-bold"></label>
                                <select asp-for="ParentId" disabled class="form-select" asp-items="ViewBag.ParentSeries">
                                    <option value="">— Brak —</option>
                                </select>
                                <span asp-validation-for="ParentId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SortOrder" class="form-label fw-bold"></label>
                                <input asp-for="SortOrder" disabled class="form-control" type="number" placeholder="0" />
                                <span asp-validation-for="SortOrder" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Image" class="form-label fw-bold"></label>
                            <input asp-for="Image" disabled class="form-control" placeholder="/images/series/nazwa.jpg" />
                            <span asp-validation-for="Image" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check form-switch">
                            <input asp-for="IsActive" disabled class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Seria aktywna</label>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <button type="submit" class="btn btn-danger px-4">
								<i class="bi bi-trash me-1"></i> Usuń serię
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
