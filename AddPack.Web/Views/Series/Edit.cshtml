@model AddPack.Models.ViewModels.SeriesEditVM

@{
    ViewData["Title"] = "Edytuj serię";
}

@section Styles {
    <link rel="stylesheet" href="~/css/manage-index.css" asp-append-version="true" />
}

<div class="container mt-4 series-edit-page">
    <div class="series-toolbar d-flex justify-content-between align-items-center mb-4 pb-2">
        <h2 class="series-page-title mb-0 fw-bolder">Edytuj serię</h2>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Wróć do listy
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="series-edit-card card border-0 shadow-sm">
                <div class="card-header text-white" style="background-color: var(--ap-green);">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Dane serii</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data" >
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="Image" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Wpisz nazwę serii" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Slug" class="form-label fw-bold"></label>
                            <input asp-for="Slug" class="form-control" placeholder="np. moja-seria" />
                            <span asp-validation-for="Slug" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Opcjonalny opis serii"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SortOrder" class="form-label fw-bold"></label>
                                <input asp-for="SortOrder" class="form-control" type="number" placeholder="0" />
                                <span asp-validation-for="SortOrder" class="text-danger small"></span>
                            </div>
                        </div>

                        @if (Model.Image != null)
                        {
                            <div class="mb-3">
                                <label asp-for="Image" class="form-label fw-bold"></label>
                                <img src="@Model.Image" class="rounded-2 preview-img" alt="Podgląd zdjęcia" />
                                <span asp-validation-for="Image" class="text-danger small"></span>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="NewImage" class="form-label fw-bold"></label>
                            <div class="ap-dropzone" id="dropzone">
                                <input type="file" asp-for="NewImage" id="fileInput" accept="image/*" class="d-none" />
                                <div id="dropzoneContent" class="text-center p-4">
                                    <i class="bi bi-cloud-arrow-up fs-1 d-block mb-2"></i>
                                    <p class="mb-1">Przeciągnij zdjęcie tutaj lub <span class="text-decoration-underline">kliknij</span></p>
                                    <small class="text-body-secondary">JPG, PNG, WEBP, GIF, max 5 MB</small>
                                </div>
                                <div class="imageWrapper">
                                    <div class="imageControlls">
                                        <img id="previewImg" class="d-none" alt="Podgląd zdjęcia" />
                                        <button type="button" id="removeImageBtn" class="btn btn-sm btn-outline-danger d-none mt-2"><i class="bi bi-trash me-1"></i> Usuń</button>
                                    </div>
                                </div>
                            </div>
                            <div id="fileError" class="text-danger small mt-2 d-none"></div>
                            <span asp-validation-for="NewImage" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check form-switch d-flex align-items-center gap-2">
                            <input asp-for="IsActive" class="form-check-input checkbox-md" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Seria aktywna</label>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                <button type="submit" class="btn btn-ap-primary px-4">
                                    <i class="bi bi-check-lg me-1"></i> Zapisz zmiany
                                </button>
                                <a asp-action="Index" class="btn btn-outline-danger shadow-sm mx-0 mx-md-2 mx-lg-2 my-2 my-lg-0">
                                    <i class="bi bi-x-lg me-1"></i> Anuluj
                                </a>
                            </span>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i> Usuń
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form.js" asp-append-version="true"></script>
}
