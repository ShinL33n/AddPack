<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AddPack</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site_theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AddPack.Web.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-addpack bg-body sticky-top py-2">
            <div class="container">
                <a class="navbar-brand ap-logo-chip" href="#">
                    <img src="~/media/logo/Logo_AddPack.svg" alt="AddPack DEMO">
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link active" href="#">Sklep</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Kategorie</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">O nas</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Kontakt</a></li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <a href="#" class="text-body-secondary fs-5"><i class="bi bi-search"></i></a>
                        <a href="#" class="text-body-secondary fs-5"><i class="bi bi-person"></i></a>
                        <a href="#" class="position-relative text-body-secondary fs-5">
                            <i class="bi bi-bag"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill badge-ap" style="font-size:0.6rem;">2</span>
                        </a>
                        <button class="theme-toggle-btn" onclick="toggleTheme()" aria-label="Przełącz motyw" title="Przełącz jasny/ciemny motyw">
                            <i class="bi bi-moon-stars theme-icon-dark"></i>
                            <i class="bi bi-sun theme-icon-light" style="display:none;"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="py-5">
        <div class="container">
            <div class="preview-note rounded-3 p-5 text-center">
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="footer-addpack bg-body pt-5 pb-0 mt-auto">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <div class="ap-brand mb-2" style="font-size:1.1rem;">
                        <span class="ap-add">Add</span><span class="ap-pack">Pack</span>
                    </div>
                    <p class="text-body-secondary small mb-0">
                        Budżetowy sprzęt outdoorowy i bushcraftowy, projektowany i testowany w polskich warunkach terenowych.
                    </p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6>Sklep</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="link-body-emphasis">Wszystkie produkty</a></li>
                        <li class="mb-2"><a href="#" class="link-body-emphasis">Kuchenki</a></li>
                        <li class="mb-2"><a href="#" class="link-body-emphasis">Akcesoria</a></li>
                        <li class="mb-2"><a href="#" class="link-body-emphasis">Nowości</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6>Informacje</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="link-body-emphasis">O AddPack</a></li>
                        <li class="mb-2"><a href="#" class="link-body-emphasis">Dostawa i zwroty</a></li>
                        <li class="mb-2"><a href="#" class="link-body-emphasis">Regulamin</a></li>
                        <li class="mb-2"><a href="#" class="link-body-emphasis">Kontakt</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6>Bądź na bieżąco</h6>
                    <p class="text-body-secondary small">Nowe produkty i wersje demo prosto na maila.</p>
                    <div class="input-group">
                        <input type="email" class="form-control" placeholder="Twój e-mail">
                        <button class="btn btn-ap-primary" type="button">Zapisz</button>
                    </div>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center py-3 mt-4 text-body-secondary">
                <span>&copy; 2026 AddPack. Wszelkie prawa zastrzeżone.</span>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a href="#" class="text-body-secondary fs-5"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-body-secondary fs-5"><i class="bi bi-facebook"></i></a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            function applyTheme(mode) {
                document.documentElement.setAttribute('data-bs-theme', mode);
                document.querySelectorAll('.theme-icon-dark').forEach(el => el.style.display = mode === 'dark' ? 'none' : 'inline-block');
                document.querySelectorAll('.theme-icon-light').forEach(el => el.style.display = mode === 'dark' ? 'inline-block' : 'none');
            }

            function toggleTheme() {
                const current = document.documentElement.getAttribute('data-bs-theme');
                applyTheme(current === 'dark' ? 'light' : 'dark');
            }

            // Domyślnie: motyw systemowy użytkownika (prefers-color-scheme).
            // W docelowym _Layout.cshtml wybór ręczny będzie dodatkowo zapisywany
            // w localStorage, żeby przeglądarka pamiętała go między wizytami.
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            applyTheme(systemPrefersDark ? 'dark' : 'light');
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
