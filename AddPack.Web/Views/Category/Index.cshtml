@model IEnumerable<AddPack.Models.Category>

@{
    ViewData["Title"] = "Zarządzanie Kategoriami";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/category-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/manage-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />
}

<form method="post" id="updateCategory">
    @Html.AntiForgeryToken()
</form>

<div class="container mt-4 series-index-page">
    <div class="series-toolbar d-flex justify-content-between align-items-center mb-4 pb-2">
        <h2 class="series-page-title mb-0 fw-bolder">Zarządzanie Kategoriami</h2>
        <a asp-controller="Category" asp-action="Upsert" class="btn btn-ap-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Dodaj nową kategorię
        </a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="categoryTable" class="category-table table table-hover align-middle mb-0 w-100">
                    <thead>
                        <tr>
                            <th scope="col" class="py-3"><i id="select-all" class="bi bi-square"></i></th>
                            <th scope="col" class="py-3">Kol.</th>
                            <th scope="col" class="py-3">Nazwa</th>
                            <th scope="col" class="py-3">Opis</th>
                            <th scope="col" class="py-3">Data utworzenia</th>
                            <th scope="col" class="py-3">Aktywna</th>
                            <th scope="col" class="py-3 text-end pe-3">Akcje</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/categories.js" asp-append-version="true"></script>
    <script src="~/js/select-items.js" asp-append-version="true"></script>
}
